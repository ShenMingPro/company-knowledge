# 模型配置
# 模型提供商：dashscope 或 ollama
MODEL_PROVIDER=dashscope

# DashScope配置（云端模式）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Ollama配置（本地模式）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2:7b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# 默认演示账号密码（请在生产环境中修改）
DEMO_EMPLOYEE_PASSWORD=employee123
DEMO_SERVICE_PASSWORD=service123
DEMO_ADMIN_PASSWORD=admin123

# SQLite 兼容模式：仅在未设置 DATABASE_URL 时使用
DATABASE_PATH=data/knowbase.db

# Docker Compose / MySQL 8
MYSQL_DATABASE=knowbase
MYSQL_USER=knowbase
MYSQL_PASSWORD=knowbase_password
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_PORT=3306
# 密码包含 @、:、/ 等字符时，请进行 URL 编码后直接设置完整连接串
DATABASE_URL=mysql+pymysql://knowbase:knowbase_password@localhost:3306/knowbase?charset=utf8mb4

# FastAPI / JWT
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ISSUER=knowbase-api
JWT_AUDIENCE=knowbase-web
ACCESS_TOKEN_EXPIRE_MINUTES=60
DOCUMENT_STORAGE_DIR=data/documents
UPLOAD_MAX_BYTES=20971520
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.docx,.txt,.xlsx
BACKEND_PORT=8000

# Redis：缓存、限流、JWT 注销和后台索引任务状态
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
REDIS_TIMEOUT_SECONDS=0.5
CACHE_TTL_SECONDS=60
TASK_STATUS_TTL_SECONDS=86400
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_IP_REQUESTS=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_QUERY_REQUESTS=30
RATE_LIMIT_UPLOAD_REQUESTS=10

# Vue 3（容器中由 Nginx 同源代理 /api）
FRONTEND_PORT=5173
VITE_API_PREFIX=/api

# 日志配置
LOG_LEVEL=INFO
LOG_PATH=logs
